---
import "@fontsource-variable/inter";
import "@fontsource/anton";
import "../styles/global.css";
import { defaultLang, resolveLocale, type Locale } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  title = "Fitness — Exercise Library",
  description = "Browse a public-domain library of strength, cardio, and mobility exercises.",
  locale = resolveLocale(Astro.currentLocale, defaultLang),
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080a" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
