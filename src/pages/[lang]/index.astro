---
import HomePage from "../../components/HomePage.astro";
import { locales, type Locale } from "../../i18n/utils";

type Props = {
  locale: Locale;
};

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
---

<HomePage locale={locale} />
