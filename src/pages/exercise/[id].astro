---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ExerciseImageCarousel from "../../components/ExerciseImageCarousel";
import type { Exercise } from "../../lib/types";

export async function getStaticPaths() {
  const entries = await getCollection("exercises");
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { exercise: { id: entry.id, ...entry.data } satisfies Exercise },
  }));
}

interface Props {
  exercise: Exercise;
}

const { exercise } = Astro.props;

const titleCase = (s: string) => s.replace(/\b\w/g, (c) => c.toUpperCase());
const tags = [
  { label: "Level", value: exercise.level },
  exercise.equipment ? { label: "Equipment", value: exercise.equipment } : null,
  { label: "Category", value: exercise.category },
  exercise.force ? { label: "Force", value: exercise.force } : null,
  exercise.mechanic ? { label: "Mechanic", value: exercise.mechanic } : null,
].filter((t): t is { label: string; value: string } => t !== null);
---

<Layout title={`${exercise.name} — Forge`}>
  <div class="mx-auto max-w-5xl px-6 pt-8 pb-14">
    <a
      href="/#browse"
      class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.22em] text-[var(--color-muted)] transition hover:text-[var(--color-accent)]"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M9 2L3 7l6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Back to library
    </a>

    <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-[1.05fr_1fr] md:items-start">
      <ExerciseImageCarousel images={exercise.images} name={exercise.name} client:load />

      <div class="flex flex-col gap-6">
        <div>
          <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--color-accent)]">
            {titleCase(exercise.category)}
          </span>
          <h1 class="mt-2 font-display text-4xl leading-[0.95] tracking-tight md:text-5xl">
            {exercise.name}
          </h1>
        </div>

        <div class="flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-3 py-1 text-xs">
              <span class="text-[var(--color-muted)]">{t.label}</span>
              <span class="text-[var(--color-text)]">{titleCase(t.value)}</span>
            </span>
          ))}
        </div>

        <div>
          <h2 class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--color-muted)]">
            Primary muscles
          </h2>
          <div class="flex flex-wrap gap-1.5">
            {exercise.primaryMuscles.map((m) => (
              <span class="rounded-full bg-[var(--color-accent)]/15 px-3 py-1 text-xs font-medium text-[var(--color-accent)]">
                {titleCase(m)}
              </span>
            ))}
          </div>
        </div>

        {exercise.secondaryMuscles.length > 0 && (
          <div>
            <h2 class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--color-muted)]">
              Secondary muscles
            </h2>
            <div class="flex flex-wrap gap-1.5">
              {exercise.secondaryMuscles.map((m) => (
                <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-text)]">
                  {titleCase(m)}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <section class="mt-12 max-w-3xl">
      <h2 class="mb-4 text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--color-muted)]">
        Instructions
      </h2>
      <ol class="space-y-4">
        {exercise.instructions.map((step, i) => (
          <li class="flex gap-3 text-base leading-relaxed text-[var(--color-text)]">
            <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-[var(--color-border-strong)] font-display text-xs text-[var(--color-accent)]">
              {i + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>
