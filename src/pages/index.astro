---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ExerciseBrowser from "../components/ExerciseBrowser";
import type { Exercise } from "../lib/types";

const entries = await getCollection("exercises");
const exercises: Exercise[] = entries.map((e) => ({ id: e.id, ...e.data }));
---

<Layout>
  <Hero exerciseCount={exercises.length} />

  <main id="browse" class="mx-auto max-w-7xl px-6 pb-24 pt-4">
    <ExerciseBrowser client:load exercises={exercises} />
  </main>

  <footer class="border-t border-[var(--color-border)] px-6 py-10 text-center text-xs tracking-wide text-[var(--color-muted)]">
    Exercise data and imagery vendored from
    <a
      href="https://github.com/yuhonas/free-exercise-db"
      class="text-[var(--color-text)] underline-offset-4 hover:underline"
      rel="noreferrer noopener"
      target="_blank">free-exercise-db</a>
    · Unlicense / public domain.
  </footer>
</Layout>
